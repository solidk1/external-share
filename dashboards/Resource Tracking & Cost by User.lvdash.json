        {
          "widget": {
            "name": "filter_owner",
            "queries": [
              {
                "name": "dashboards/01f1406cec7e151dab2177f6ed566794/datasets/01f1406d832211dea3d938485c157276_owner",
                "query": {
                  "datasetName": "all_resources",
                  "fields": [
                    {
                      "name": "owner",
                      "expression": "`owner`"
                    }
                  ],
                  "disaggregated": false
                }
              }
